# =============================================================================
# API ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and update with your values

# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/uni-feedback

# Environment
NODE_ENV=development

# API Server
PORT=3001
API_URL=http://localhost:3001
DASHBOARD_URL=localhost:5174
WEBSITE_URL=http://localhost:3000

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,https://uni-feedback.com,https://ssr.uni-feedback.com,https://admin.uni-feedback.com

RESEND_API_KEY=
POSTHOG_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenRouter (optional - for AI-powered feedback categorization)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# AI Chat (/chat). THE kill switch: whether answers are generated and money is
# spent. Off unless this says otherwise, because an environment that never set
# it should not be running a paid model. Turn it on as a deliberate act,
# separately from the deploy that ships the code.
#
# Distinct from SHOW_CHAT_ENTRY_POINTS in apps/website-ssr, which only decides
# whether the site advertises the chat. The two are allowed to disagree; see
# that file. This one is authoritative: with it off, nothing is answered no
# matter what the website shows.
#
# Read at startup, so flipping it means restarting the API, not editing a file.
CHAT_ENABLED=false
# Optional, all have sensible defaults in apps/api/src/config/chat.ts:
# CHAT_DAILY_MESSAGE_LIMIT   per user per day (default 30)
# CHAT_DAILY_COST_CEILING_MICROS  global spend ceiling, micro-euros (default 5000000 = 5 EUR)
# CHAT_HOURLY_IP_LIMIT       per IP per hour (default 40)
# CHAT_MODEL / CHAT_CHEAP_MODEL   answering and title models

# R2 Storage for PDF Reports
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=uni-feedback-reports

# Report template version (increment to invalidate cache when template changes)
REPORT_TEMPLATE_VERSION=1

# Feature Flags
# Validate that submitted feedback emails match the faculty's allowed email suffixes
VALIDATE_EMAIL_SUFFIX=false