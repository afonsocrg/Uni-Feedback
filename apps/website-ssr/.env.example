# =============================================================================
# WEBSITE-SSR ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and update with your values

# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/uni-feedback

# Environment
NODE_ENV=development

# Server
PORT=3000

# Site URL - Used for meta tags, sitemaps, and canonical URLs
# Development: http://localhost:3000
# Production: https://uni-feedback.com
VITE_PUBLIC_SITE_URL=http://localhost:3000

# API Base URL - Injected at runtime via window.ENV in SSR
# Development: http://localhost:3001
# Production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:3001

# CDN URL for assets (logos, images, etc.)
# Development and Production can use the same public R2 bucket
VITE_CDN_URL=https://cdn.uni-feedback.com

# PostHog Analytics
VITE_PUBLIC_POSTHOG_KEY=your_posthog_api_key_here
VITE_PUBLIC_POSTHOG_HOST=https://e.uni-feedback.com

# Microsoft Clarity Analytics (Production only)
VITE_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id_here

# Whether to ADVERTISE the chat: navbar chip, footer link, mobile drawer, and the
# "ask about this" buttons on course, degree, faculty and browse pages.
# This is NOT the kill switch. That is CHAT_ENABLED on the API, which decides
# whether answers are generated at all. The two are allowed to disagree:
#   API on  + this off  = soft launch. Works at /chat, advertised nowhere.
#   API off + this on   = an incident. Links lead to the honest resting screen.
# /chat itself is never hidden by this, so bookmarks keep working.
# Server-side runtime var: read with process.env in the root loader, so changing
# it needs a restart of this server, not a rebuild.
SHOW_CHAT_ENTRY_POINTS=false
